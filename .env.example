# 飞牛 Docker 中 TriliumNext 的 ETAPI 地址。
# 如果 TriliumNext 与本项目在同一自定义 Docker 网络，推荐改成 http://trilium:8080
# 如果 TriliumNext 通过 NAS 主机端口 8080 暴露，使用 http://host.docker.internal:8080
TRILIUM_BASE_URL=http://host.docker.internal:8080
TRILIUM_ETAPI_TOKEN=请填写TriliumNext的ETAPI令牌
TRILIUM_BLOG_ROOT_NOTE_ID=请填写longBlog根笔记ID
TRILIUM_TEMPLATE_NOTE_ID=MC7PtiChdF5S

# GitHub 博客仓库。推荐 SSH deploy key，不要把 Token 写进本文件。
LONGBLOG_REPO_URL=git@github.com:minlonghuo-lab/longBlog.git
LONGBLOG_GIT_REMOTE=origin
LONGBLOG_GIT_BRANCH=main
LONGBLOG_GIT_USER_NAME=longBlog Bot
LONGBLOG_GIT_USER_EMAIL=longblog-bot@users.noreply.github.com
LONGBLOG_GIT_SSH_KEY=/data/ssh/id_ed25519

# 轮询间隔，默认 60 秒；不建议低于 30 秒。
LONGBLOG_POLL_INTERVAL=60
LONGBLOG_RUN_TIMEOUT=1200
LONGBLOG_RUNTIME_DIR=/data/runtime
LONGBLOG_REPO_DIR=/data/workspace/current

# 可选：只有使用文章 AI 摘要/标签功能时才填写。
# DEEPSEEK_API_KEY=
# LONGBLOG_DEEPSEEK_MODEL=deepseek-chat

TZ=Asia/Shanghai

# Bark 推送（可选）
# 留空则不发送通知。示例：https://api.day.app/你的Key
LONGBLOG_BARK_BASE_URL=
LONGBLOG_BARK_ICON_URL=
LONGBLOG_BARK_GROUP=longBlog
LONGBLOG_BARK_ENABLED=true
